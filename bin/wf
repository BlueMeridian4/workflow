#!/usr/bin/env node
// wf <command> [args]. Single entry point; same on Linux/Mac/Windows. `wf help` lists commands.
const fs = require('fs'), path = require('path');
const { spawnSync } = require('child_process');

const root = path.join(__dirname, '..');
const claude = ['go', 'research', 'plan', 'lint', 'lean', 'review', 'ship']; // each runs /workflow:<name>
const logjs = { log: [], decide: ['--decide'], pr: ['--review'], find: ['--find'], board: ['--board'], ctx: ['--session'] }; // wf command -> log.js flag
const [cmd = 'help', ...args] = process.argv.slice(2);
const run = (c, a) => process.exit(spawnSync(c, a, { stdio: 'inherit', shell: process.platform === 'win32' }).status ?? 1);
const help = () => process.stdout.write(fs.readFileSync(path.join(root, 'help.txt'), 'utf8'));

if (cmd === 'commands') console.log(['help', ...Object.keys(logjs), ...claude].join(' ')); // used by shell completion
else if (cmd === 'help' || cmd === '-h' || cmd === '--help') help();
else if (logjs[cmd]) run('node', [path.join(root, 'log.js'), ...logjs[cmd], ...args]);
else if (claude.includes(cmd)) {
  if (cmd === 'research') spawnSync('node', [path.join(root, 'log.js'), '--board', '--research'], { stdio: 'ignore' }); // show where findings will land
  run('claude', [`/workflow:${cmd} ${args.join(' ')}`.trim()]);
}
else { console.error(`wf: unknown command "${cmd}"\n`); help(); process.exit(1); }
